# Copy to .env (setup.sh does this for you) and adjust as needed.

# --- LLM -------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Default: Ollama running on the host.
# From inside Docker, the host is reachable at host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
# Not needed for Ollama. Set it when using a cloud provider.
LLM_API_KEY=
# "none" disables thinking on reasoning models (qwen3): ~100x faster for simple calls.
# Leave empty to not send it (some cloud models reject "none").
LLM_REASONING_EFFORT=none
# Lower = more predictable output. Agents want low.
LLM_TEMPERATURE=0.2
# Seconds to wait for one LLM response.
LLM_TIMEOUT=300

# --- Limits ------------------------------------------------------------------
MAX_STEPS_PER_AGENT=50
MAX_RUN_MINUTES=60

# --- Ports -------------------------------------------------------------------
DASHBOARD_PORT=3000
WORKSPACE_API_PORT=8000
LANGFUSE_PORT=3001
